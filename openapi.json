  "info": {
    "title": "Bahia Escondida API",
    "description": "REST API for Bahia Escondida backend. Authenticated routes require a Bearer JWT. The clientId is taken from the token — do not send it in request bodies for tenant-scoped resources.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Registration, login, and session"
    },
    {
      "name": "clients",
      "description": "Business tenant management"
    },
    {
      "name": "products",
      "description": "Menu products and options"
    },
    {
      "name": "sales",
      "description": "Orders / tabs"
    },
    {
      "name": "payments",
      "description": "Sale payments"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "JWT access token from POST /auth/login or POST /auth/register"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "staff@restaurant.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "secret12345"
          },
          "name": {
            "type": "string",
            "example": "Maria"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "STAFF"
            ],
            "example": "STAFF"
          },
          "clientId": {
            "type": "number",
            "example": 1,
            "description": "Business client id the user belongs to"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "PublicUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "email": {
            "type": "string",
            "example": "staff@restaurant.com"
          },
          "name": {
            "type": "string",
            "example": "Maria"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "STAFF"
            ],
            "example": "STAFF"
          },
          "clientId": {
            "type": "number",
            "example": 1,
            "description": "Business client id linked to this user"
          }
        },
        "required": [
          "id",
          "email",
          "role"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/PublicUserDto"
          },
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "description": "JWT access token"
          }
        },
        "required": [
          "user",
          "accessToken"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "staff@restaurant.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "example": "secret12345"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateClientDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Bahia Escondida"
          },
          "email": {
            "type": "string",
            "example": "contact@bahia.com"
          },
          "phone": {
            "type": "string",
            "example": "+56912345678"
          },
          "address": {
            "type": "string",
            "example": "Av. Costanera 123"
          }
        },
        "required": [
          "name"
        ]
      },
      "ClientDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Bahia Escondida"
          },
          "email": {
            "type": "string",
            "example": "contact@bahia.com"
          },
          "phone": {
            "type": "string",
            "example": "+56912345678"
          },
          "address": {
            "type": "string",
            "example": "Av. Costanera 123"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "ProductOptionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "productId": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Burger"
          },
          "price": {
            "type": "number",
            "example": 0
          }
        },
        "required": [
          "id",
          "productId",
          "name",
          "price"
        ]
      },
      "ProductDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "clientId": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Promo 5"
          },
          "price": {
            "type": "number",
            "example": 15000
          },
          "category": {
            "type": "string",
            "enum": [
              "FOOD",
              "DRINKS"
            ],
            "example": "FOOD"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "example": "active"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductOptionDto"
            }
          }
        },
        "required": [
          "id",
          "clientId",
          "name",
          "price",
          "category",
          "status",
          "createdAt",
          "updatedAt",
          "options"
        ]
      },
      "CreateProductOptionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Burger"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "example": 0,
            "description": "Extra charge for this option (0 if included)"
          }
        },
        "required": [
          "name",
          "price"
        ]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Promo 5"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "example": 15000
          },
          "category": {
            "enum": [
              "FOOD",
              "DRINKS"
            ],
            "type": "string",
            "example": "FOOD"
          },
          "options": {
            "description": "Optional choices for combo / configurable products",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateProductOptionDto"
            }
          }
        },
        "required": [
          "name",
          "price",
          "category"
        ]
      },
      "AddProductOptionsDto": {
        "type": "object",
        "properties": {
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateProductOptionDto"
            }
          }
        },
        "required": [
          "options"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {}
      },
      "SaleProductOptionLineDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "productOptionId": {
            "type": "number",
            "example": 12
          },
          "optionName": {
            "type": "string",
            "example": "Burger"
          },
          "price": {
            "type": "number",
            "example": 0
          }
        },
        "required": [
          "id",
          "productOptionId",
          "optionName",
          "price"
        ]
      },
      "SaleProductLineDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 10,
            "description": "Sale line item id"
          },
          "productId": {
            "type": "number",
            "example": 5
          },
          "name": {
            "type": "string",
            "example": "Promo 5"
          },
          "price": {
            "type": "number",
            "example": 15000
          },
          "quantity": {
            "type": "number",
            "example": 1
          },
          "observation": {
            "type": "string",
            "example": "Sin cebolla"
          },
          "category": {
            "type": "string",
            "example": "FOOD"
          },
          "selectedOptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaleProductOptionLineDto"
            }
          }
        },
        "required": [
          "id",
          "productId",
          "name",
          "price",
          "quantity",
          "selectedOptions"
        ]
      },
      "SaleDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "clientId": {
            "type": "number",
            "example": 1
          },
          "isDelivery": {
            "type": "boolean",
            "example": false
          },
          "tableNumber": {
            "type": "number",
            "example": 4
          },
          "customerNickname": {
            "type": "string",
            "example": "Carlos"
          },
          "partySize": {
            "type": "number",
            "example": 2
          },
          "status": {
            "type": "string",
            "example": "abierta",
            "enum": [
              "abierta",
              "cerrada"
            ]
          },
          "closedAt": {
            "format": "date-time",
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaleProductLineDto"
            }
          }
        },
        "required": [
          "id",
          "clientId",
          "isDelivery",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateSaleDto": {
        "type": "object",
        "properties": {
          "isDelivery": {
            "type": "boolean",
            "example": false
          },
          "tableNumber": {
            "type": "number",
            "minimum": 1,
            "example": 4
          },
          "customerNickname": {
            "type": "string",
            "example": "Carlos"
          },
          "partySize": {
