generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  name     String?
  role     UserRole @default(STAFF)
  clientId Int?

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Client {
  id      Int     @id @default(autoincrement())
  name    String
  email   String?
  phone   String?
  address String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales    Sale[]
  products Product[]
  users    User[]
}

model Product {
  id       Int     @id @default(autoincrement())
  clientId Int
  name     String
  price    Decimal @db.Decimal(10, 2)
  category String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  options ProductOption[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  SaleProduct SaleProduct[]

  @@index([clientId])
  @@index([category])
}

model ProductOption {
  id        Int     @id @default(autoincrement())
  productId Int
  name      String
  price     Decimal @db.Decimal(10, 2)

  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  SaleProductOption SaleProductOption[]

  @@index([productId])
}

model Sale {
  id             Int    @id @default(autoincrement())
  clientId       Int
  saleType       String
  saleIdentifier String
  partySize      Int?
  status         String @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  products SaleProduct[]

  @@index([clientId])
  @@index([status])
  @@index([saleType])
}

model SaleProduct {
  id          Int     @id @default(autoincrement())
  saleId      Int
  productId   Int
  name        String
  price       Decimal @db.Decimal(10, 2)
  observation String?

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  options SaleProductOption[]

  @@index([saleId])
  @@index([productId])
}

model SaleProductOption {
  id              Int     @id @default(autoincrement())
  saleProductId   Int
  productOptionId Int
  optionName      String
  price           Decimal @db.Decimal(10, 2)

  saleProduct   SaleProduct   @relation(fields: [saleProductId], references: [id], onDelete: Cascade)
  productOption ProductOption @relation(fields: [productOptionId], references: [id])

  @@index([saleProductId])
  @@index([productOptionId])
}
